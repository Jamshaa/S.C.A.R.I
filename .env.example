# S.C.A.R.I Environment Configuration
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env to version control

# ==================== APPLICATION SETTINGS ====================
ENV=development
LOG_LEVEL=info
DEBUG=false

# ==================== BACKEND SETTINGS ====================
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ==================== FRONTEND SETTINGS ====================
FRONTEND_PORT=5173
VITE_API_BASE=http://localhost:8000
NODE_ENV=development

# ==================== THERMAL CONFIGURATION ====================
MAX_TEMP=60.0
AMBIENT_TEMP=25.0
MIN_TEMP=20.0

# Cooling parameters
MAX_FAN_POWER=550.0
MAX_PUMP_POWER=100.0

# ==================== TRAINING SETTINGS ====================
TRAINING_TIMESTEPS=600000
LEARNING_RATE=0.0002
TRAINING_STEPS=2048
BATCH_SIZE=128

# Model paths
MODEL_SAVE_DIR=./outputs/models
DATA_DIR=./data
CONFIG_FILE=configs/optimized.yaml

# ==================== SECURITY ====================
# CORS (add your deployment URL here)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false
# Set this to protect admin endpoints from non-local access.
# Remote clients must then send X-API-Key with the same value.
SCARI_API_KEY=

# ==================== PERFORMANCE ====================
MAX_WORKERS=4
WORKER_TIMEOUT=120
